    {"name": "Evidence", "type": "SINGLE_SELECT", "options": ["Hypothesis", "Source reviewed", "Synthetic", "Browser observed", "User validated"]},
    {"name": "Use case", "type": "TEXT"},
    {"name": "Acceptance", "type": "TEXT"}
